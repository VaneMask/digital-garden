---
import BaseLayout from '@components/layout/BaseLayout.astro'
import HeroSection from '@components/home/HeroSection.astro'
import ScrollReveal from '@components/ui/ScrollReveal.astro'
import ProjectCard from '@components/projects/ProjectCard.astro'
import { getCollection } from 'astro:content'

const projects = await getCollection('projects')
projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const featured = projects.filter((p) => p.data.featured).slice(0, 3)
const posts = await getCollection('posts', ({ data }) => !data.draft)
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const recent = posts.slice(0, 4)
---

<BaseLayout>
  <HeroSection />

  <!-- Featured projects -->
  <section class="section-container">
    <ScrollReveal>
      <div class="text-center mb-16">
        <p class="text-xs font-bold tracking-[0.2em] text-[var(--color-accent)] uppercase mb-3">Selected Work</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text-primary)]">精选项目</h2>
      </div>
    </ScrollReveal>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-7xl mx-auto scroll-reveal-stagger">
      {featured.length === 0 ? (
        <p class="col-span-full text-center text-[var(--color-text-muted)] py-8">暂无项目。</p>
      ) : (
        featured.map((project) => (
          <ProjectCard {...project.data} slug={project.id} />
        ))
      )}
    </div>

    <ScrollReveal>
      <div class="text-center mt-12">
        <a href="/projects" class="inline-flex items-center gap-1.5 text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors duration-200">
          查看全部项目
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
        </a>
      </div>
    </ScrollReveal>
  </section>

  <!-- Recent posts -->
  <section class="section-container bg-[var(--color-bg-secondary)]/30">
    <ScrollReveal>
      <div class="text-center mb-16">
        <p class="text-xs font-bold tracking-[0.2em] text-[var(--color-accent)] uppercase mb-3">Latest Notes</p>
        <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-text-primary)]">近期笔记</h2>
      </div>
    </ScrollReveal>

    <div class="max-w-3xl mx-auto space-y-3 scroll-reveal-stagger">
      {recent.length === 0 ? (
        <p class="text-center text-[var(--color-text-muted)] py-8">暂无文章。</p>
      ) : (
        recent.map((post) => (
          <a href={`/archive/`} class="group flex items-center justify-between glass-card p-5 tilt-card" style="transform-style: preserve-3d;">
            <div>
              <h3 class="font-medium text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors duration-200">{post.data.title}</h3>
              <p class="text-sm text-[var(--color-text-muted)] mt-1 line-clamp-1">{post.data.description}</p>
            </div>
            <time datetime={post.data.date.toISOString()} class="shrink-0 ml-4 text-xs text-[var(--color-text-muted)]">
              {new Intl.DateTimeFormat('zh-CN', { month: '2-digit', day: '2-digit' }).format(post.data.date)}
            </time>
          </a>
        ))
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // Hero parallax
  function initParallax() {
    const hero = document.querySelector('section')
    const blobs = hero?.querySelectorAll('[class*="animate-float"]')
    if (!hero || !blobs?.length) return

    const handleScroll = () => {
      const scrollY = window.scrollY
      const heroHeight = hero.offsetHeight
      if (scrollY > heroHeight) return

      const progress = scrollY / heroHeight
      const content = hero.querySelector('.relative.z-10') as HTMLElement
      if (content) {
        content.style.transform = `translateY(${progress * 60}px)`
        content.style.opacity = `${1 - progress * 1.2}`
      }

      blobs.forEach((blob, i) => {
        const speed = 0.3 + i * 0.15
        const el = blob as HTMLElement
        el.style.transform = `translateY(${scrollY * speed}px)`
      })
    }

    window.addEventListener('scroll', handleScroll, { passive: true })
  }

  initParallax()
  document.addEventListener('astro:page-load', initParallax)
</script>
