---
import BaseLayout from '@components/layout/BaseLayout.astro'
import ScrollReveal from '@components/ui/ScrollReveal.astro'
import BaseConverter from '@components/tools/BaseConverter'
import PomodoroTimer from '@components/tools/PomodoroTimer'
import TodoList from '@components/tools/TodoList'
import InspirationBoard from '@components/tools/InspirationBoard'
import MarkdownEditor from '@components/tools/MarkdownEditor'
import ImageCompressor from '@components/tools/ImageCompressor'
import SpinnerWheel from '@components/tools/SpinnerWheel'
---

<BaseLayout title="自制工具">
  <div class="section-container">
    <ScrollReveal>
      <div class="text-center mb-16">
        <p class="text-xs font-medium tracking-[0.2em] text-accent-500 uppercase mb-3">DIY Tools</p>
        <h1 class="text-3xl md:text-4xl font-bold text-ink-100 dark:text-ink-inverted tracking-tight">自制工具</h1>
        <p class="mt-3 text-sm text-ink-300 dark:text-ink-inverted/40">实用小工具，数据保存在本地浏览器</p>
      </div>
    </ScrollReveal>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto scroll-reveal-stagger">

      <!-- 进制转换 -->
      <div class="glass-card p-6">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-lg">🔢</span>
          <h2 class="text-base font-bold text-ink-100 dark:text-ink-inverted">进制转换</h2>
        </div>
        <BaseConverter client:load />
      </div>

      <!-- 番茄钟 -->
      <div class="glass-card p-6">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-lg">🍅</span>
          <h2 class="text-base font-bold text-ink-100 dark:text-ink-inverted">番茄钟</h2>
        </div>
        <PomodoroTimer client:load />
      </div>

      <!-- 待办清单 -->
      <div class="glass-card p-6">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-lg">✅</span>
          <h2 class="text-base font-bold text-ink-100 dark:text-ink-inverted">待办清单</h2>
        </div>
        <TodoList client:load />
      </div>

      <!-- 灵感记录 -->
      <div class="glass-card p-6">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-lg">💡</span>
          <h2 class="text-base font-bold text-ink-100 dark:text-ink-inverted">灵感记录</h2>
        </div>
        <InspirationBoard client:load />
      </div>

      <!-- Markdown 编辑器 -->
      <div class="glass-card p-6 md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-lg">📝</span>
          <h2 class="text-base font-bold text-ink-100 dark:text-ink-inverted">Markdown 编辑器</h2>
        </div>
        <MarkdownEditor client:load />
      </div>

      <!-- 图片压缩 -->
      <div class="glass-card p-6 md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-lg">🖼️</span>
          <h2 class="text-base font-bold text-ink-100 dark:text-ink-inverted">图片压缩</h2>
        </div>
        <ImageCompressor client:load />
      </div>

      <!-- 转盘决策 -->
      <div class="glass-card p-6 md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-lg">🎯</span>
          <h2 class="text-base font-bold text-ink-100 dark:text-ink-inverted">转盘决策</h2>
        </div>
        <SpinnerWheel client:load />
      </div>

    </div>
  </div>
</BaseLayout>
