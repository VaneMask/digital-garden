---
import BaseLayout from '@components/layout/BaseLayout.astro'
import AboutClient from '@components/about/AboutClient'
import { getCollection } from 'astro:content'

// Gather activities from posts and moments
const posts = await getCollection('posts', ({ data }) => !data.draft)
const moments = await getCollection('moments')

const activities = [
  ...posts.map((p) => ({
    date: p.data.date.toISOString(),
    title: p.data.title,
    type: '文章',
    url: '/archive',
  })),
  ...moments.map((m) => ({
    date: m.data.date.toISOString(),
    title: m.data.content.slice(0, 20),
    type: '说说',
    url: '/moments',
  })),
].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
---

<BaseLayout title="关于">
  <div class="section-container prose-container">
    <div class="bg-white/60 dark:bg-white/[0.02] backdrop-blur-xl rounded-[2.5rem] shadow-card dark:shadow-card-dark border border-black/5 dark:border-white/5 overflow-hidden">
      <AboutClient activities={activities} client:load />
    </div>

    <!-- Contact -->
    <div class="mt-12 text-center">
      <p class="text-sm text-ink-300 dark:text-ink-inverted/40 mb-6">想聊聊？欢迎随时联系</p>
      <a href="mailto:hi@vanemask.me" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-ink-100 dark:bg-ink-inverted text-surface-100 dark:text-surface-900 text-sm font-medium hover:opacity-80 transition-opacity">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
        发送邮件
      </a>
    </div>
  </div>
</BaseLayout>

<style is:inline>
  @keyframes fadeUpIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
