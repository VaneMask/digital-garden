---
import BaseLayout from '@components/layout/BaseLayout.astro'
import MomentList from '@components/moments/MomentList'
import { getCollection } from 'astro:content'

const raw = await getCollection('moments')
raw.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const moments = raw.map((m) => ({
  id: m.id,
  content: m.data.content,
  images: m.data.images,
  tags: m.data.tags,
  date: m.data.date,
  location: m.data.location,
}))
---

<BaseLayout title="说说">
  <MomentList moments={moments} client:load />
</BaseLayout>

<style is:inline>
  @keyframes fadeUpIn {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
