---
import BaseLayout from '@components/layout/BaseLayout.astro'
import ScrollReveal from '@components/ui/ScrollReveal.astro'
import { getCollection } from 'astro:content'

const moments = await getCollection('moments')
moments.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<BaseLayout title="说说">
  <div class="section-container">
    <ScrollReveal>
      <div class="text-center mb-20">
        <p class="text-xs font-medium tracking-[0.2em] text-accent-500 uppercase mb-3">Moments</p>
        <h1 class="text-3xl md:text-4xl font-bold text-ink-100 dark:text-ink-inverted tracking-tight">说说</h1>
        <p class="mt-3 text-ink-300 dark:text-ink-inverted/50">碎碎念，日常记录</p>
      </div>
    </ScrollReveal>
    <div class="max-w-lg mx-auto space-y-5 scroll-reveal-stagger">
      {moments.length === 0 ? (
        <p class="text-center text-ink-300/60 py-16">暂无</p>
      ) : (
        moments.map((m) => {
          const d = new Intl.DateTimeFormat('zh-CN', { year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit' }).format(m.data.date)
          return (
            <div class="glass-card p-5">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-7 h-7 rounded-full bg-gradient-to-br from-accent-400 to-accent-600 flex items-center justify-center text-white text-[10px] font-bold">V</div>
                <span class="text-xs text-ink-300/70">{d}</span>
              </div>
              <p class="text-ink-100 dark:text-ink-inverted leading-relaxed whitespace-pre-wrap text-sm">{m.data.content}</p>
              {m.data.images && m.data.images.length > 0 && (
                <div class={`mt-4 grid gap-2 ${m.data.images.length===1?'grid-cols-1':'grid-cols-2'}`}>
                  {m.data.images.map((img:string) => <img src={img} alt="" loading="lazy" class="rounded-xl w-full object-cover lazy-image" />)}
                </div>
              )}
              {m.data.tags && m.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-4">
                  {m.data.tags.map((tag:string) => <span class="text-[11px] px-2 py-0.5 rounded-md bg-accent-50 dark:bg-accent-400/10 text-accent-500">#{tag}</span>)}
                </div>
              )}
            </div>
          )
        })
      )}
    </div>
  </div>
</BaseLayout>
