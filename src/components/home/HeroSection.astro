---
import { SITE } from '@config/constants'
import SocialLinks from './SocialLinks.astro'
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Animated background -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute top-[-20%] left-[-10%] w-[80vw] h-[80vw] md:w-[60vw] md:h-[60vw] rounded-full bg-[var(--gradient-hero-1)] animate-float blur-3xl" />
    <div class="absolute top-[40%] right-[-15%] w-[70vw] h-[70vw] md:w-[50vw] md:h-[50vw] rounded-full bg-[var(--gradient-hero-2)] animate-float-delayed blur-3xl" />
    <div class="absolute bottom-[-10%] left-[30%] w-[60vw] h-[60vw] md:w-[40vw] md:h-[40vw] rounded-full bg-[var(--gradient-hero-3)] animate-float-slow blur-3xl" />
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6 max-w-2xl mx-auto">
    <!-- Avatar -->
    <div class="mb-8 inline-block">
      <div class="w-24 h-24 md:w-28 md:h-28 rounded-full bg-gradient-to-br from-accent-400 to-accent-600 p-[3px] shadow-glow animate-fade-in">
        <div class="w-full h-full rounded-full bg-[var(--color-bg-primary)] flex items-center justify-center">
          <span class="text-3xl md:text-4xl font-bold gradient-text">{SITE.name.charAt(0)}</span>
        </div>
      </div>
    </div>

    <!-- Name & Tagline -->
    <h1 class="text-3xl md:text-5xl font-bold text-[var(--color-text-primary)] tracking-tight animate-fade-in-up">
      {SITE.name}
    </h1>
    <p class="mt-4 text-lg md:text-xl text-[var(--color-text-secondary)] animate-fade-in-up" style="animation-delay: 0.1s">
      {SITE.description}
    </p>

    <!-- Intro -->
    <p class="mt-6 text-sm md:text-base text-[var(--color-text-muted)] leading-relaxed max-w-lg mx-auto animate-fade-in-up" style="animation-delay: 0.2s">
      计算机科学在读，热爱设计与开发。<br class="hidden sm:block" />
      这里是我的数字花园，记录学习、思考与生活。
    </p>

    <!-- Social links -->
    <div class="mt-8 animate-fade-in-up" style="animation-delay: 0.3s">
      <SocialLinks />
    </div>

    <!-- Scroll hint -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-pulse-soft">
      <svg class="w-5 h-5 text-[var(--color-text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>
</section>
