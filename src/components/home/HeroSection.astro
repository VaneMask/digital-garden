---
import { SITE } from '@config/constants'
import SocialLinks from './SocialLinks.astro'
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Blue-pink gradient atmosphere -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <!-- Top-right pink blob -->
    <div class="absolute -top-[15%] -right-[15%] w-[80vw] h-[80vw] md:w-[55vw] md:h-[55vw] rounded-full opacity-80 md:opacity-70 bg-rose-300 dark:bg-rose-400/70 blur-[80px] md:blur-[140px] animate-float" />
    <!-- Bottom-left blue blob -->
    <div class="absolute top-[35%] -left-[15%] w-[75vw] h-[75vw] md:w-[45vw] md:h-[45vw] rounded-full opacity-80 md:opacity-70 bg-sky-300 dark:bg-sky-400/70 blur-[80px] md:blur-[120px] animate-float-delay" />
    <!-- Center purple accent -->
    <div class="absolute top-[20%] left-[20%] w-[60vw] h-[60vw] md:w-[35vw] md:h-[35vw] rounded-full opacity-70 md:opacity-60 bg-accent-300 dark:bg-accent-400/60 blur-[70px] md:blur-[100px] animate-float-slow" />
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6 max-w-3xl mx-auto">
    <!-- Greeting -->
    <p class="animate-fade-up text-sm font-medium tracking-[0.3em] text-rose-400 mb-6">
      秋
    </p>

    <!-- Avatar -->
    <div class="mb-0 inline-block animate-fade-up-delay">
      <div class="w-28 h-28 md:w-32 md:h-32 rounded-full ring-1 ring-black/5 dark:ring-white/10 ring-offset-2 ring-offset-surface-100 dark:ring-offset-surface-900 overflow-hidden shadow-card">
        <img src="/images/avatar.jpg" alt={SITE.name} class="w-full h-full object-cover" />
      </div>
    </div>

    <!-- Name -->
    <!-- removed: big name text -->

    <!-- Tagline -->
    <p class="animate-fade-up-delay mt-6 text-lg md:text-xl text-ink-300 dark:text-ink-inverted/60 font-light leading-relaxed max-w-xl mx-auto">
      {SITE.description}
    </p>

    <!-- Divider -->
    <div class="animate-fade-up-delay-2 mt-10 flex items-center justify-center gap-4">
      <span class="h-px w-12 bg-ink-300/30" />
      <span class="h-1 w-1 rounded-full bg-accent-400" />
      <span class="h-px w-12 bg-ink-300/30" />
    </div>

    <!-- Social -->
    <div class="animate-fade-up-delay-2 mt-10">
      <SocialLinks />
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-ink-300/60 dark:text-ink-inverted/20">
    <span class="text-[10px] uppercase tracking-[0.3em]">Scroll</span>
    <svg class="w-4 h-4 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
