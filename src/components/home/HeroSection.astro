﻿---
import { SITE } from '@config/constants'
import SocialLinks from './SocialLinks.astro'
---

<section class="relative pt-28 pb-16 md:pt-36 md:pb-20 px-6">

  <!-- Content -->
  <div class="relative z-10 w-full max-w-xl mx-auto">
    <!-- Profile Card -->
    <div class="animate-fade-up glass-card p-5 sm:p-7 cursor-pointer group">
      <div class="flex items-start gap-5 sm:gap-6">
        <!-- Avatar with animated gradient border + breathe effect -->
        <div class="w-[88px] h-[88px] sm:w-[104px] sm:h-[104px] rounded-[18px] sm:rounded-[22px] gradient-border-animated p-1 shadow-lg flex-shrink-0 transition-transform duration-500 group-hover:rotate-3 group-hover:scale-105">
          <img src="/images/avatar.jpg" alt={SITE.name} class="w-full h-full rounded-[14px] sm:rounded-[18px] object-cover bg-white dark:bg-slate-800 avatar-breathe" />
        </div>

        <!-- Name + Bio -->
        <div class="flex-1 min-w-0 pt-2">
          <h1 class="text-xl sm:text-2xl font-bold text-accent-500 leading-snug tracking-wider">
            秋
          </h1>
          <p class="mt-2 text-[13px] sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            {SITE.description}
          </p>
        </div>
      </div>

      <!-- Social Links -->
      <div class="mt-6 pt-5 border-t border-black/5 dark:border-white/5">
        <SocialLinks />
      </div>
    </div>

    <!-- Skills Tags with typing effect -->
    <div class="mt-6 animate-fade-up-delay-2">
      <div class="flex flex-wrap gap-2 justify-center" id="skills-container">
        <span class="px-3 py-1.5 text-xs font-medium rounded-full bg-accent-50 dark:bg-accent-400/10 text-accent-600 dark:text-accent-400 border border-accent-200/50 dark:border-accent-400/20">Web 开发</span>
        <span class="px-3 py-1.5 text-xs font-medium rounded-full bg-sky-50 dark:bg-sky-400/10 text-sky-600 dark:text-sky-400 border border-sky-200/50 dark:border-sky-400/20">前端设计</span>
        <span class="px-3 py-1.5 text-xs font-medium rounded-full bg-rose-50 dark:bg-rose-400/10 text-rose-600 dark:text-rose-400 border border-rose-200/50 dark:border-rose-400/20">UI/UX</span>
        <span class="px-3 py-1.5 text-xs font-medium rounded-full bg-violet-50 dark:bg-violet-400/10 text-violet-600 dark:text-violet-400 border border-violet-200/50 dark:border-violet-400/20">TypeScript</span>
      </div>
    </div>
  </div>

</section>

<script>
  // Add subtle entrance animation to skill tags
  function animateSkills() {
    const container = document.getElementById('skills-container');
    if (!container) return;

    const tags = container.querySelectorAll('span');
    tags.forEach((tag, index) => {
      (tag as HTMLElement).style.opacity = '0';
      (tag as HTMLElement).style.transform = 'translateY(10px)';
      setTimeout(() => {
        (tag as HTMLElement).style.transition = 'all 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
        (tag as HTMLElement).style.opacity = '1';
        (tag as HTMLElement).style.transform = 'translateY(0)';
      }, 100 + index * 80);
    });
  }

  animateSkills();
  document.addEventListener('astro:page-load', animateSkills);
</script>
