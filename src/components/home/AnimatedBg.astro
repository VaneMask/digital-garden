<div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
  <!-- Large blobs -->
  <div class="absolute top-[-20%] left-[-10%] w-[60vw] h-[60vw] rounded-full bg-[var(--gradient-hero-1)] animate-float blur-3xl" />
  <div class="absolute top-[40%] right-[-15%] w-[50vw] h-[50vw] rounded-full bg-[var(--gradient-hero-2)] animate-float-delayed blur-3xl" />
  <div class="absolute bottom-[-10%] left-[30%] w-[40vw] h-[40vw] rounded-full bg-[var(--gradient-hero-3)] animate-float-slow blur-3xl" />

  <!-- Subtle grid overlay -->
  <div class="absolute inset-0 opacity-[0.015] dark:opacity-[0.03]" style="background-image: radial-gradient(circle, var(--color-text-primary) 1px, transparent 1px); background-size: 40px 40px;" />
</div>
