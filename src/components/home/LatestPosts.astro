---
import { getCollection } from 'astro:content'
import ScrollReveal from '@components/ui/ScrollReveal.astro'

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(date)
---

{posts.length > 0 && (
  <section class="py-12 md:py-16 px-6">
    <div class="glass-card p-8 md:p-10">
      <ScrollReveal>
        <div class="flex items-end justify-between mb-12">
          <div>
            <p class="text-xs font-medium tracking-[0.2em] text-accent-500 uppercase mb-2">Latest</p>
            <h2 class="text-2xl md:text-3xl font-bold text-ink-100 dark:text-ink-inverted tracking-tight">
              最近文章
            </h2>
          </div>
          <a
            href="/archive"
            class="text-sm text-ink-300 dark:text-ink-inverted/40 hover:text-accent-500 transition-colors duration-200 hidden sm:block"
          >
            查看全部 →
          </a>
        </div>
      </ScrollReveal>

      <div class="space-y-4 scroll-reveal-stagger">
        {posts.map((post) => (
          <a href={`/archive/${post.id}`} class="group block glass-card p-5 md:p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1 min-w-0">
                <h3 class="text-base md:text-lg font-semibold text-ink-100 dark:text-ink-inverted group-hover:text-accent-500 transition-colors duration-300 truncate">
                  {post.data.title}
                </h3>
                <p class="mt-1.5 text-sm text-ink-300 dark:text-ink-inverted/50 line-clamp-2 leading-relaxed">
                  {post.data.description}
                </p>
                <div class="flex items-center gap-2 mt-3">
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <span class="text-[11px] px-2 py-0.5 rounded-md bg-surface-200 dark:bg-surface-800 text-ink-300 dark:text-ink-inverted/40">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <time datetime={post.data.date.toISOString()} class="text-xs text-ink-300/50 dark:text-ink-inverted/25 whitespace-nowrap mt-1 flex-shrink-0">
                {formatDate(post.data.date)}
              </time>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-8 text-center sm:hidden">
        <a href="/archive" class="text-sm text-ink-300 dark:text-ink-inverted/40 hover:text-accent-500 transition-colors duration-200">
          查看全部 →
        </a>
      </div>
    </div>
  </section>
)}
