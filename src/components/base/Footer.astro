---
import { SITE, SOCIAL_LINKS } from '@config/constants'
---

<footer class="border-t border-[var(--color-border)] py-12 mt-auto">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="text-sm text-[var(--color-text-muted)]">
        &copy; {new Date().getFullYear()} {SITE.name}. Built with Astro.
      </div>
      <div class="flex items-center gap-4">
        {SOCIAL_LINKS.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors duration-200"
          >
            {link.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
