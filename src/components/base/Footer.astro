---
import { SITE, SOCIAL_LINKS } from '@config/constants'
---

<footer class="border-t border-black/5 dark:border-white/5 py-10 mt-auto">
  <div class="max-w-4xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-xs text-ink-300/80 dark:text-ink-inverted/30">
      &copy; {new Date().getFullYear()} {SITE.name}
    </p>
    <div class="flex items-center gap-6">
      {SOCIAL_LINKS.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-ink-300/80 dark:text-ink-inverted/30 hover:text-accent-500 transition-colors duration-200"
        >
          {link.name}
        </a>
      ))}
    </div>
  </div>
</footer>
