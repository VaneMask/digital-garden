---
import { SITE, NAV_LINKS } from '@config/constants'

const currentPath = Astro.url.pathname
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 h-[var(--nav-height)] transition-all duration-300"
  class:list={[
    'bg-[var(--nav-bg)] backdrop-blur-[12px] -webkit-backdrop-blur-[12px]',
    'border-b border-[var(--color-border)]',
  ]}
>
  <nav class="max-w-7xl mx-auto h-full flex items-center justify-between px-4 md:px-6">
    <!-- Logo -->
    <a
      href="/"
      class="text-lg font-semibold tracking-tight text-[var(--color-text-primary)] hover:text-[var(--color-accent)] transition-colors duration-200 shrink-0"
    >
      {SITE.name}
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-1">
      {NAV_LINKS.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
        return (
          <li>
            <a
              href={link.href}
              class:list={[
                'relative px-4 py-2 text-sm rounded-full transition-all duration-200',
                isActive
                  ? 'text-[var(--color-accent)] bg-[var(--color-accent-bg)] font-medium'
                  : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:bg-[var(--color-bg-secondary)]',
              ]}
            >
              {link.label}
            </a>
          </li>
        )
      })}
      <li class="ml-2">
        <button
          id="theme-toggle"
          type="button"
          class="w-9 h-9 flex items-center justify-center rounded-full text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] hover:bg-[var(--color-bg-secondary)] transition-all duration-200"
          aria-label="切换主题"
        >
          <svg id="sun-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg id="moon-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
      </li>
    </ul>

    <!-- Mobile: hamburger -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden relative w-10 h-10 flex items-center justify-center rounded-full text-[var(--color-text-primary)] hover:bg-[var(--color-bg-secondary)] transition-all duration-200 z-[80]"
      aria-label="菜单"
    >
      <svg id="menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <!-- Mobile fullscreen overlay -->
  <div
    id="mobile-menu"
    class="md:hidden fixed inset-0 z-[70] opacity-0 pointer-events-none transition-opacity duration-500"
  >
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-[var(--color-bg-primary)]/85 backdrop-blur-2xl" />

    <!-- Content -->
    <div class="relative h-full flex flex-col items-center justify-center px-6">
      <nav class="flex flex-col items-center gap-4 w-full max-w-xs">
        {NAV_LINKS.map((link, i) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
          return (
            <a
              href={link.href}
              data-menu-item
              style={`transition-delay: ${i * 60}ms`}
              class:list={[
                'mobile-menu-item w-full py-4 px-6 rounded-2xl text-center text-xl font-medium transition-all duration-500 opacity-0 translate-y-4',
                isActive
                  ? 'bg-[var(--color-accent)]/10 text-[var(--color-accent)]'
                  : 'text-[var(--color-text-primary)] hover:bg-[var(--color-bg-secondary)]',
              ]}
            >
              {link.label}
            </a>
          )
        })}
        <div
          data-menu-item
          style={`transition-delay: ${NAV_LINKS.length * 60}ms`}
          class="mobile-menu-item w-full pt-6 mt-6 border-t border-[var(--color-border)] opacity-0 translate-y-4 transition-all duration-500"
        >
          <button
            id="mobile-theme-toggle"
            type="button"
            class="w-full py-3 rounded-2xl text-sm border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-all duration-200"
          >
            切换深浅色
          </button>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  function setupTheme() {
    const html = document.documentElement
    const toggle = document.getElementById('theme-toggle')
    const mobileToggle = document.getElementById('mobile-theme-toggle')
    const sunIcon = document.getElementById('sun-icon')
    const moonIcon = document.getElementById('moon-icon')

    function updateIcons() {
      const isDark = html.classList.contains('dark')
      if (sunIcon) sunIcon.style.display = isDark ? 'block' : 'none'
      if (moonIcon) moonIcon.style.display = isDark ? 'none' : 'block'
    }

    function toggleTheme() {
      const isDark = html.classList.toggle('dark')
      localStorage.setItem('theme', isDark ? 'dark' : 'light')
      updateIcons()
    }

    toggle?.addEventListener('click', toggleTheme)
    mobileToggle?.addEventListener('click', toggleTheme)
    updateIcons()
  }

  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn')
    const menu = document.getElementById('mobile-menu')
    const menuIconOpen = document.getElementById('menu-icon-open')
    const menuIconClose = document.getElementById('menu-icon-close')
    const items = menu?.querySelectorAll('.mobile-menu-item')
    const links = menu?.querySelectorAll('a')
    let isOpen = false

    function open() {
      isOpen = true
      menu?.classList.remove('opacity-0', 'pointer-events-none')
      document.body.style.overflow = 'hidden'
      menuIconOpen?.classList.add('hidden')
      menuIconClose?.classList.remove('hidden')
      // Stagger items in
      items?.forEach((item) => {
        item.classList.remove('opacity-0', 'translate-y-4')
      })
    }

    function close() {
      isOpen = false
      menu?.classList.add('opacity-0', 'pointer-events-none')
      document.body.style.overflow = ''
      menuIconOpen?.classList.remove('hidden')
      menuIconClose?.classList.add('hidden')
      // Reset items
      items?.forEach((item) => {
        item.classList.add('opacity-0', 'translate-y-4')
      })
    }

    btn?.addEventListener('click', () => {
      isOpen ? close() : open()
    })

    links?.forEach((link) => {
      link.addEventListener('click', close)
    })
  }

  setupTheme()
  setupMobileMenu()

  document.addEventListener('astro:page-load', () => {
    setupTheme()
    setupMobileMenu()
  })
</script>
