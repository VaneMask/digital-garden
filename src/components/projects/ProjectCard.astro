---
import Badge from '@components/ui/Badge.astro'

export interface Props {
  title: string
  description: string
  summary?: string
  coverImage?: string
  techTags: string[]
  githubUrl?: string
  demoUrl?: string
  date: Date
  slug: string
}

const { title, description, summary, coverImage, techTags, githubUrl, date, slug } = Astro.props
const displayDate = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long' }).format(date)
---

<a href={`/projects/${slug}`} class="group block glass-card overflow-hidden">
  {/* Cover image area */}
  <div class="aspect-video -mx-6 -mt-6 mb-5 bg-gradient-to-br from-accent-100 to-accent-50 dark:from-accent-500/10 dark:to-accent-400/5 overflow-hidden">
    {coverImage ? (
      <img src={coverImage} alt={title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <span class="text-4xl font-bold gradient-text">{title.charAt(0)}</span>
      </div>
    )}
  </div>

  {/* Content */}
  <div class="flex flex-col gap-3">
    <div class="flex items-start justify-between gap-4">
      <h3 class="text-lg font-semibold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors duration-200">
        {title}
      </h3>
      {githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 mt-0.5 text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors duration-200"
          onclick="(e) => e.stopPropagation()"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>
      )}
    </div>

    <p class="text-sm text-[var(--color-text-secondary)] line-clamp-2">
      {summary || description}
    </p>

    <div class="flex items-center justify-between mt-1">
      <time datetime={date.toISOString()} class="text-xs text-[var(--color-text-muted)]">
        {displayDate}
      </time>
      <div class="flex flex-wrap gap-1.5">
        {techTags.slice(0, 3).map((tag) => (
          <Badge variant="small">{tag}</Badge>
        ))}
        {techTags.length > 3 && (
          <span class="text-xs text-[var(--color-text-muted)]">+{techTags.length - 3}</span>
        )}
      </div>
    </div>
  </div>
</a>
