---
export interface Props {
  variant?: 'default' | 'small'
  class?: string
}

const { variant = 'default', class: className = '' } = Astro.props
---

<span
  class:list={[
    'inline-flex items-center rounded-full bg-[var(--color-accent-bg)] text-[var(--color-accent)] font-medium transition-colors duration-200',
    variant === 'small' ? 'px-2.5 py-0.5 text-xs' : 'px-3 py-1 text-sm',
    className,
  ]}
>
  <slot />
</span>
