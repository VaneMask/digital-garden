---
export interface Props {
  items: Array<{
    title: string
    description: string
    date: Date
    href: string
    tags?: string[]
    categories?: string[]
  }>
}

const { items } = Astro.props

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date)
}
---

<div class="relative">
  <!-- Timeline line -->
  <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-[var(--color-border)] md:-translate-x-px" />

  <div class="space-y-12">
    {items.map((item) => (
      <div class="relative flex items-start gap-6 md:gap-0">
        <!-- Date -->
        <div class="hidden md:block w-1/2 pr-12 text-right">
          <time datetime={item.date.toISOString()} class="text-sm text-[var(--color-text-muted)] sticky top-24">
            {formatDate(item.date)}
          </time>
        </div>

        <!-- Dot -->
        <div class="absolute left-4 md:left-1/2 w-3 h-3 rounded-full bg-[var(--color-accent)] border-2 border-[var(--color-bg-primary)] -translate-x-1/2 mt-1.5 z-10" />

        <!-- Content -->
        <div class="md:w-1/2 md:pl-12 ml-10 md:ml-0">
          {/* Mobile date */}
          <time datetime={item.date.toISOString()} class="text-xs text-[var(--color-text-muted)] mb-2 block md:hidden">
            {formatDate(item.date)}
          </time>
          <a href={item.href} class="block glass-card p-5 group">
            <h3 class="font-medium text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors duration-200">
              {item.title}
            </h3>
            <p class="text-sm text-[var(--color-text-secondary)] mt-1.5 line-clamp-2">{item.description}</p>
            {item.tags && item.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mt-3">
                {item.tags.slice(0, 4).map((tag) => (
                  <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--color-bg-secondary)] text-[var(--color-text-muted)]">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        </div>
      </div>
    ))}
  </div>
</div>
