---
export interface Props {
  name: string
  description: string
  icon?: string
  url: string
}

const { name, description, icon, url } = Astro.props
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="glass-card p-5 flex items-start gap-4 group"
>
  {/* Icon */}
  <div class="shrink-0 w-10 h-10 rounded-xl bg-[var(--color-accent-bg)] flex items-center justify-center text-[var(--color-accent)]">
    {icon ? (
      <span class="text-lg">{icon}</span>
    ) : (
      <span class="text-sm font-semibold">{name.charAt(0)}</span>
    )}
  </div>

  {/* Text */}
  <div class="min-w-0">
    <h3 class="font-medium text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors duration-200 truncate">
      {name}
    </h3>
    <p class="text-sm text-[var(--color-text-secondary)] mt-0.5 line-clamp-1">
      {description}
    </p>
  </div>

  {/* Arrow */}
  <svg class="shrink-0 w-4 h-4 mt-1 text-[var(--color-text-muted)] group-hover:text-[var(--color-accent)] group-hover:translate-x-0.5 transition-all duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
  </svg>
</a>
